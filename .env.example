# Warsaw Transit Delay Telemetry Engine - Environment Configuration Template
# Copy this file to .env and configure your own values:
# cp .env.example .env

# Optional: Dead Man's Switch / Heartbeat URL from Healthchecks.io
# If provided, collector_daemon sends /start, regular 15-min pings, and /fail notifications.
HEARTBEAT_URL=https://hc-ping.com/YOUR-UUID-HERE

# Cloud Backup (rclone) Configuration
RCLONE_REMOTE=gdrive
DEST_FOLDER=WarsawDelayTelemetry/data/raw

# Data storage paths
RAW_DIR=data/raw
GTFS_DIR=data/gtfs

# Optional: Warsaw Transit GTFS-RT Protobuf and Static Schedule endpoints
# WARSAW_GTFS_RT_URL=https://api.zbiorkom.live/api6-open/warsaw/gtfsRealtime/default/vehiclePositions,tripUpdates,serviceAlerts
# WARSAW_STATIC_GTFS_URL=https://api.zbiorkom.live/api6-open/warsaw/gtfs/default

# --- Warsaw Observed-Delay Historian Configuration ---
# City of Warsaw Open Data API Key (api.um.warszawa.pl)
UM_WARSAW_API_KEY=your_api_um_warszawa_pl_key_here

# Historian Polling & Storage Configuration
HISTORIAN_POLL_PERIOD_S=10
HISTORIAN_ZBK_POLL_PERIOD_S=30
HISTORIAN_HEALTH_INTERVAL_S=300
HISTORIAN_DATA_DIR=data/historian

# Optional: Historian Dead Man's Switch / Heartbeat URL from Healthchecks.io (5-min check)
# HISTORIAN_HEARTBEAT_URL=https://hc-ping.com/YOUR-HISTORIAN-UUID-HERE
# HISTORIAN_BACKUP_DEST=gdrive:WarsawDelayTelemetry/data/historian
